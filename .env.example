# Environment Configuration
NODE_ENV=development
PORT=5500

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pos_db?schema=public"

# JWT Configuration
JWT_ACCESS_SECRET="pos_super_secret_access_token_key_change_in_production_2026"
JWT_ACCESS_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="pos_super_secret_refresh_token_key_change_in_production_2026"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS Configuration (comma-separated origins or '*' to allow all)
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

# Admin Initial Credentials (for seeding/first run)
ADMIN_INITIAL_EMAIL="admin@virapos.com"
ADMIN_INITIAL_PASSWORD="Admin@123"
